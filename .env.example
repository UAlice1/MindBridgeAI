# YourVoice AI - Environment Variables
# Copy this file to .env and add your actual API keys

# ============================================
# GROQ API (Required for AI Chat)
# ============================================
# Get your free API key from: https://console.groq.com
VITE_GROQ_API_KEY=your_groq_api_key_here

# ============================================
# OPENAI API (Optional - Alternative to Groq)
# ============================================
# Get your API key from: https://platform.openai.com
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# ============================================
# NOTES
# ============================================
# 1. Rename this file to .env (remove .example)
# 2. Replace 'your_groq_api_key_here' with actual key
# 3. Never commit .env file to git (it's in .gitignore)
# 4. Restart dev server after changing this file
